# Settings for the live system (~/attedance.shulepoa.co.ke/.env on the server).
# deploy/server.js passes these to every service; deploy-attendance.sh never
# overwrites the server's copy. Do not set PORT — Passenger sets it.

# Own cPanel PostgreSQL database (separate from the portal's bdnxkzmx_shulepoa)
DATABASE_URL=postgresql+asyncpg://DBUSER:DBPASSWORD@localhost:5432/DBNAME

# Same value for every service: signs and checks login tokens
SECRET_KEY=change-me
# Service-to-service key (gateway, device service and school service share it)
NOTIFICATION_INTERNAL_KEY=change-me
INTERNAL_API_KEY=change-me
# Fernet key for stored fingerprint templates. Never change it once enrolments
# exist, or the saved templates cannot be read back.
TEMPLATE_ENCRYPTION_KEY=change-me

# Lists are JSON
ALLOWED_ORIGINS=["https://attedance.shulepoa.co.ke"]
APP_BASE_URL=https://attedance.shulepoa.co.ke

SIMULATION_MODE=false
ATTENDANCE_TIMEZONE=Africa/Nairobi
ATTENDANCE_ANTI_BOUNCE_SECONDS=90
DEVICE_DEFAULT_PORT=4370
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Internal ports: 5 services from here, website at +10
INTERNAL_PORT_BASE=38100

# Email for /management (sends school admins their sign-in + licence certificate).
# cPanel mailbox, e.g. attedance@shulepoa.co.ke; 465 = SSL, 587 = STARTTLS.
# SMTP_HOST=mail.shulepoa.co.ke
# SMTP_PORT=465
# SMTP_USERNAME=attedance@shulepoa.co.ke
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=attedance@shulepoa.co.ke
# SMTP_FROM_NAME=Shulepoa Attendance

# SMS (Africa's Talking) — fill in to send parent alerts
# AFRICASTALKING_USERNAME=
# AFRICASTALKING_API_KEY=
# AFRICASTALKING_SENDER_ID=
